# Due Diligence Backend - Environment Configuration
# ALL configuration must be set here - NO hardcoded defaults in code

# ============================================
# API Configuration (REQUIRED)
# ============================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=meta-llama/llama-3.3-70b-instruct

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/due_diligence
REDIS_URL=redis://localhost:6379/0

# ============================================
# Processing Configuration
# ============================================
CHUNK_SIZE=500
CHUNK_OVERLAP=100
SIMILARITY_THRESHOLD=0.7
MAX_CITATIONS=5
CONFIDENCE_THRESHOLD=0.6

# ============================================
# Server Configuration
# ============================================
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ============================================
# Application Configuration
# ============================================
APP_NAME=Due Diligence Questionnaire Agent
APP_VERSION=1.0.0

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=*
CORS_CREDENTIALS=true
CORS_METHODS=*
CORS_HEADERS=*

# ============================================
# File Upload Configuration
# ============================================
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=52428800

# ============================================
# Questionnaire Configuration
# ============================================
QUESTIONNAIRE_PATH=data/ILPA_Due_Diligence_Questionnaire_v1.2.pdf
MAX_QUESTIONS_PER_BATCH=10
